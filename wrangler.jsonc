{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-bot-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // isomorphic-git 全局 Buffer 依赖（wiki 模式，§2.3 compressWiki）
  "compatibility_flags": ["nodejs_compat"],
  // Workflow/Queue 步级 CPU 上限（付费档最大 5min；§5.3 optimize-batch 依赖此值）
  "limits": {
    "cpu_ms": 300000
  },
  "observability": {
    "enabled": true
  },
  // wrangler d1 create image-bot-db（APAC）2026-11-17
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "image-bot-db",
      "database_id": "aaf1cfbd-33ce-4a3b-b2b1-cd5108a76b5d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STAGING",
      "bucket_name": "image-bot-staging"
    }
  ],
  "queues": {
    "producers": [{ "queue": "router", "binding": "ROUTER" }],
    "consumers": [
      {
        "queue": "router",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "router-dlq"
      },
      // P0：DLQ 捕获消费者 —— 消息落 D1 dead_letters（不再重试，max_retries: 0）
      {
        "queue": "router-dlq",
        "max_batch_size": 10,
        "max_retries": 0
      }
    ]
  },
  "workflows": [
    {
      "name": "optimize-run",
      "binding": "OPTIMIZE",
      "class_name": "OptimizeRun"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REPO_LOCK", "class_name": "RepoLock" },
      { "name": "IMAGE_CONTAINER", "class_name": "ImageContainer" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RepoLock"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ImageContainer"]
    }
  ],
  // §6.3 超大图兜底：容器内 jpegtran/optipng/gifsicle + sharp（standard-1 = 0.5 vCPU/1GB 起）
  "containers": [
    {
      "name": "image-container",
      "class_name": "ImageContainer",
      "image": "./container/Dockerfile",
      "max_instances": 2,
      "instance_type": "standard-1"
    }
  ],
  // ["*/30 * * * *" = 卡死 PR 巡检, "0 3 * * *" = schedule 重优化扫描] 见 DESIGN.md §2.4
  "triggers": {
    "crons": ["*/30 * * * *", "0 3 * * *"]
  },
  // 仪表盘 "Install now" 直达安装页（§13.3 installUrl；slug 公开信息非密钥）
  // QUOTA_DAILY_RUNS：D10 多租户配额（每 installation 每 UTC 日 run 上限；0 = 不限）
  // PUBLIC_BASE_URL：OAuth redirect_uri 钉死到正式域名（防 Host 头注入/多域名漂移）
  "vars": {
    "GITHUB_APP_SLUG": "image-bot-cf",
    "QUOTA_DAILY_RUNS": "0",
    "PUBLIC_BASE_URL": "https://imgbot.alanpally.com"
  },
  // P3 仪表盘：静态资源与 API 同域；/api/* 先进 Worker，其余交资产层（SPA 兜底）
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "routes": [
    { "pattern": "imgbot.alanpally.com", "custom_domain": true }
  ]
}
