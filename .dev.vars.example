# 复制为 .dev.vars 填写（已被 .gitignore 忽略，勿提交真凭据）
# GitHub App 凭据：Settings → Developer settings → GitHub Apps → 你的 App
GITHUB_APP_ID=
# PEM 全文（含 BEGIN/END 行，换行可写成 \n 或保持多行）
GITHUB_PRIVATE_KEY=
# Webhook secret（App 页面 Webhook secret 字段同一值）
GITHUB_WEBHOOK_SECRET=
# （可选）GitHub App slug——仪表盘 "Install now" 直达安装页；缺省兜底到 GitHub 安装管理页
GITHUB_APP_SLUG=
